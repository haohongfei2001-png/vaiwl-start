{
  "name": "vaiwl-start",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, metadata-only ChatGPT new tab catalog",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/unit-receipt.mjs",
    "build": "node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "test:browser": "node tests/browser/extension.mjs",
    "package": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run audit",
    "test:edge-tabstrip": "node tests/browser/edge-tabstrip.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
